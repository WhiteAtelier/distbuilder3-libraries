{
    "repository": "https://github.com/SOCI/soci",
    "entries": [
        {
            "version": "4.1.4",
            "options": {
                "shared": false
            },
            "dependencies": {
                // Declare dependencies ...
                "fmtlib.fmt": {
                    "version": ["..."]
                }
            },
            "steps": {
                "order": [
                    "download",
                    "download_amalgamation_sqlite3",
                    "configure",
                    "build",
                    "copy_license"
                ],
                "download": {
                    "cmd": "github-download",
                    "ref": "v${version}",
                    "hash": "bbe8a095ccdc7eff567b4811fd0c318d6aaa0b415352cd9569e815b1b61973b2"
                },
                "download_amalgamation_sqlite3": {
                    // sqlite3 は amalgamation 版を使う
                    "cmd": "github-download",
                    "ref": "46a41f159b163d50fbb914c729d237e6b54ae72d",
                    "hash": "cd4852db16cd34dd0d5dd4b2519b250fb02032d24d99cc6affd70200856563bf",
                    "author": "vadz",
                    "repo": "sqlite-amalgamation",
                    "archive_path": "sqlite-amalgamation-src.zip",
                    "output_dir": "src/3rdparty/sqlite3"
                },
                "configure": {
                    "cmd": "cmake-configure",
                    "args": [
                        "-DSOCI_SHARED=${options.shared}",
                        "-DSOCI_INSTALL=ON",
                        "-DSOCI_TESTS=OFF",
                        "-DWITH_BOOST=OFF"
                    ]
                },
                "build": {
                    "cmd": "cmake-install-all",
                    "build_dir": "build"
                },
                "copy_license": {
                    "cmd": "install-file",
                    "source_file": "src/LICENSE_1_0.txt",
                    "destination_dir": "."
                }
            },
            "license": "LICENSE_1_0.txt"
        }
    ]
}
