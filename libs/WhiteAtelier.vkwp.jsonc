{
    "repository": "https://github.com/WhiteAtelier/vkwp",
    "entries": [
        {
            "version": "2.2.1",
            "options": {
                "support_glfw_surface": false,
                "support_win32_surface": false
            },
            "dependencies": {
                "gabime.spdlog": {},
                "glfw.glfw": {
                    "condition": "${options.support_glfw_surface}"
                }
            },
            "steps": {
                "order": ["download", "configure", "build"],
                "download": {
                    "cmd": "github-download",
                    "ref": "v${version}",
                    "hash": "6eb223b13769d4a5d853a8886cc2a33d4906114550378286a9b4efc2387be8a0"
                },
                "configure": {
                    "cmd": "cmake-configure",
                    "args": [
                        "-DVKWP_SUPPORT_GLFW_SURFACE=${options.support_glfw_surface}",
                        "-DVKWP_SUPPORT_WIN32_SURFACE=${options.support_win32_surface}",
                        "-DVKWP_BUILD_TESTS=OFF",
                        "-DVKWP_BUILD_DOCS=OFF",
                        "-DVKWP_INSTALL=ON"
                    ]
                },
                "build": {
                    "cmd": "cmake-install-all",
                    "build_dir": "build"
                }
            },
            "license": "!NoLicense"
        },
        {
            "version": "2.3.0",
            "base": "${previous}",
            "steps": {
                "download": {
                    "hash": "a83d843c5dcf2bfdc2f0f5325d7e5f80089e1d2f61766f113c9d85f129114a54"
                }
            }
        },
        {
            "version": "2.3.1",
            "base": "${previous}",
            "steps": {
                "download": {
                    "hash": "b57820c7812e795f6d064515203d104d990d9f0f78c3831bc3617bc0d3a88e70"
                }
            }
        },
        {
            "version": "2.4.0",
            "base": "${previous}",
            "steps": {
                "download": {
                    "hash": "64d22ade99e9cfe1cded61780fa7bcf0379e8b3cdc538b938d4d44f12713359e"
                }
            }
        }
    ]
}
